{
  "name": "@allgreen/allgreen",
  "version": "0.0.1",
  "description": "A heartbeat / ping / uptime checker",
  "scripts": {
    "internal:init": "pnpm internal:initJWTSecret",
    "web:dev": "pnpm --filter ./apps/web dev",
    "web:build": "pnpm --filter ./apps/web build",
    "web:check": "pnpm --filter ./apps/web check",
    "docs:dev": "pnpm --filter ./apps/docs dev",
    "docs:build": "pnpm --filter ./apps/docs build",
    "docs:check": "pnpm --filter ./apps/docs check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:miggen": "pnpm db:generate && pnpm db:migrate",
    "internal:initJWTSecret": "tsx packages/database/src/jwtSecretManager.ts",
    "server:dev": "tsx watch apps/server/src/index.ts",
    "server:start": "tsx apps/server/src/index.ts",
    "security:scan:dir": "gitleaks dir .",
    "security:scan:git": "gitleaks git .",
    "security:scan:all": "pnpm security:scan:dir && pnpm security:scan:git"
  },
  "keywords": [
    "database",
    "ping",
    "uptime",
    "checker",
    "uptime-checker"
  ],
  "author": "constt",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  }
}
